--- !u!114 &-942735559525199417
MonoBehaviour:
  m_ObjectHideFlags: 1
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 4374796b23b64d7a85bd45b60a78ef97, type: 3}
  m_Name: CodeSampleParagraph
  m_EditorClassIdentifier: Unity.Tutorials.Editor::Unity.Tutorials.Editor.Paragraphs.CodeSampleParagraph
  m_MaskingSettings:
    m_MaskingEnabled: 0
    m_UnmaskedViews: []
    MaskPreset: {fileID: 0}
  CodeSample: "using UnityEngine;\r\n\r\n\r\npublic class DoorOpener : MonoBehaviour\r\n{\r\n   private Animator doorAnimator;\r\n\r\n   void Start()\r\n   {\r\n       // Get the Animator component attached to the same GameObject as this script\r\n       doorAnimator = GetComponent<Animator>();\r\n   }\r\n\r\n   private void OnTriggerEnter(Collider other)\r\n   {\r\n       // Check if the object entering the trigger is the player (or another specified object)\r\n       if (other.CompareTag(\"Player\")) // Make sure the player GameObject has the tag \"Player\"\r\n       {\r\n           if (doorAnimator != null)\r\n           {\r\n               // Trigger the Door_Open animation\r\n               doorAnimator.SetTrigger(\"Door_Open\");\r\n           }\r\n       }\r\n   }\r\n}\r"
