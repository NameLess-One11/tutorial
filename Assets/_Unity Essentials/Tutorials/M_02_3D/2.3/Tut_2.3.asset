--- !u!114 &1832678432292353170
MonoBehaviour:
  m_ObjectHideFlags: 1
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 935228c0fd2628c4db5028980babef0b, type: 3}
  m_Name: NarrativeParagraph
  m_EditorClassIdentifier: Unity.Tutorials.Editor::Unity.Tutorials.Editor.Paragraphs.NarrativeParagraph
  m_MaskingSettings:
    m_MaskingEnabled: 0
    m_UnmaskedViews: []
    MaskPreset: {fileID: 0}
  Text:
    m_Untranslated: "Now you\u2019ll use the block prefab you created to build a small tower in your Unity scene. The process of constructing a tower not only tests your ability to use prefabs efficiently, but it also allows you to experiment with object positioning in Unity. \n\n<b>Note:</b> The tower doesn\u2019t need to be perfect! As long as it stands up, it'll work well.  In fact, it may even be more visually interesting if it\u2019s not perfectly aligned!"
--- !u!114 &2825326227667762264
MonoBehaviour:
  m_ObjectHideFlags: 1
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 456c7c2b477e4253b9e4faf9ed4b18a9, type: 3}
  m_Name: InstructionsParagraph
  m_EditorClassIdentifier: Unity.Tutorials.Editor::Unity.Tutorials.Editor.Paragraphs.InstructionsParagraph
  m_MaskingSettings:
    m_MaskingEnabled: 0
    m_UnmaskedViews: []
    MaskPreset: {fileID: 0}
  Title:
    m_Untranslated: Instructions
  Text:
    m_Untranslated: "<b>1.</b>  With the <b>Block </b>GameObject selected, select <b>Add Component</b> at the bottom of the <b>Inspector</b> window, then search for and add a <b>Rigidbody</b> component.\n\n<b>2.</b>  Enter <b>Play</b> mode to test the interaction. \n\nObserve that the block now gets knocked over when hit by the ball. \n\n<b>Note:</b>  Remember to save your scene often with <b>Ctrl+S</b> (macOS: <b>Cmd+S</b>)."
  m_CriteriaCompletion: 0
  m_Criteria:
    m_Items: []
--- !u!114 &3576634151934362970
MonoBehaviour:
  m_ObjectHideFlags: 1
  m_CorrespondingSourceObject: {fileID: 0}
